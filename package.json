{
  "name": "agentic-operator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "env:check": "tsx scripts/check-env.ts",
    "dev": "node scripts/dev-bootstrap.mjs && next dev -p 3002",
    "dev:next-only": "next dev -p 3002",
    "dev:demo": "node scripts/dev-bootstrap.mjs && STUB_AGENTS=1 next dev -p 3002",
    "dev:next-only:demo": "STUB_AGENTS=1 next dev -p 3002",
    "inngest:up": "docker compose -f docker-compose.inngest.yml up -d",
    "inngest:down": "docker compose -f docker-compose.inngest.yml down",
    "inngest:logs": "docker compose -f docker-compose.inngest.yml logs -f",
    "inngest:dev": "inngest-cli dev",
    "converter:up": "docker compose -f docker-compose.gotenberg.yml up -d --wait",
    "converter:down": "docker compose -f docker-compose.gotenberg.yml down",
    "converter:logs": "docker compose -f docker-compose.gotenberg.yml logs -f",
    "pg:up": "docker compose -f docker-compose.postgres.yml up -d",
    "pg:down": "docker compose -f docker-compose.postgres.yml down",
    "pg:logs": "docker compose -f docker-compose.postgres.yml logs -f",
    "archive": "tsx --env-file=.env.local scripts/inngest-archiver.ts",
    "monitor:sweep": "tsx --env-file=.env.local scripts/monitor-sweeper.ts",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:converter:integration": "DOCUMENT_CONVERTER_URL=${DOCUMENT_CONVERTER_URL:-http://127.0.0.1:3009} RUN_GOTENBERG_INTEGRATION=1 vitest run lib/resume-convert/gotenberg.integration.test.ts --reporter=verbose",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed-from-sidecars.ts",
    "db:migrate-from-sqlite": "tsx --env-file=.env.local scripts/migrate-sqlite-to-pg.ts",
    "register": "tsx --env-file=.env.local scripts/register-with-inngest.ts",
    "publish:test": "tsx --env-file=.env.local scripts/publish-test-event.ts",
    "minio:list": "tsx --env-file=.env.local scripts/list-minio-resumes.ts",
    "minio:pick": "tsx --env-file=.env.local scripts/pick-test-resume.ts",
    "gen:v4-snapshot": "node --env-file=.env.local --import tsx scripts/gen-v4-snapshot.ts",
    "simulate:rule-check": "tsx --env-file=.env.local scripts/simulate-rule-check-real-run.ts",
    "emit:real-run": "tsx --env-file=.env.local scripts/publish-real-run-event.ts",
    "raas-mirror:up": "tsx --env-file=.env.local scripts/raas-mirror-up.ts",
    "raas-mirror:seed-demo": "tsx --env-file=.env.local scripts/raas-mirror-seed-demo.ts",
    "deploy:check": "npm run deploy:shared:check",
    "deploy:config": "npm run deploy:shared:config",
    "deploy:up": "npm run deploy:shared:up",
    "deploy:ps": "npm run deploy:shared:ps",
    "deploy:logs": "npm run deploy:shared:logs",
    "deploy:down": "npm run deploy:shared:down",
    "deploy:shared:check": "node scripts/deploy-preflight.mjs --env-file .env.deploy --expect-mode shared --expect-volume-mode new",
    "deploy:shared:config": "npm run deploy:shared:check && bash scripts/deploy-compose.sh --env-file .env.deploy --expect-mode shared --expect-volume-mode new -- config --quiet",
    "deploy:shared:up": "npm run deploy:shared:check && bash scripts/deploy-compose.sh --env-file .env.deploy --expect-mode shared --expect-volume-mode new -- up -d --build --wait",
    "deploy:shared:pg:up": "npm run deploy:shared:check && bash scripts/deploy-compose.sh --env-file .env.deploy --expect-mode shared --expect-volume-mode new -- up -d --wait ao-postgres",
    "deploy:shared:ps": "bash scripts/deploy-compose.sh --env-file .env.deploy --expect-mode shared --expect-volume-mode new -- ps",
    "deploy:shared:logs": "bash scripts/deploy-compose.sh --env-file .env.deploy --expect-mode shared --expect-volume-mode new -- logs -f --tail=200",
    "deploy:shared:down": "bash scripts/deploy-compose.sh --env-file .env.deploy --expect-mode shared --expect-volume-mode new -- down",
    "deploy:shared:reuse-pg:config": "node scripts/deploy-preflight.mjs --env-file .env.deploy --expect-mode shared --expect-volume-mode external && bash scripts/deploy-compose.sh --env-file .env.deploy --expect-mode shared --expect-volume-mode external -- config --quiet",
    "deploy:bundled:check": "node scripts/deploy-preflight.mjs --env-file .env.deploy --expect-mode bundled --expect-volume-mode new",
    "deploy:bundled:config": "npm run deploy:bundled:check && bash scripts/deploy-compose.sh --env-file .env.deploy --expect-mode bundled --expect-volume-mode new -- config --quiet",
    "deploy:bundled:up": "npm run deploy:bundled:check && bash scripts/deploy-compose.sh --env-file .env.deploy --expect-mode bundled --expect-volume-mode new -- up -d --build --wait",
    "deploy:bundled:ps": "bash scripts/deploy-compose.sh --env-file .env.deploy --expect-mode bundled --expect-volume-mode new -- ps",
    "deploy:bundled:logs": "bash scripts/deploy-compose.sh --env-file .env.deploy --expect-mode bundled --expect-volume-mode new -- logs -f --tail=200",
    "deploy:bundled:down": "bash scripts/deploy-compose.sh --env-file .env.deploy --expect-mode bundled --expect-volume-mode new -- down"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "eventsource-parser": "^3.0.8",
    "inngest": "^4.3.0",
    "libphonenumber-js": "^1.13.9",
    "minio": "^8.0.7",
    "neo4j-driver": "^6.0.1",
    "next": "16.2.4",
    "openai": "^6.34.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "pinyin-pro": "^3.28.1",
    "prisma": "^7.8.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "^9.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.19.0",
    "unpdf": "^1.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.9.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "happy-dom": "^20.9.0",
    "inngest-cli": "^1.19.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  }
}
